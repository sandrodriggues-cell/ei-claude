    <!-- O Snoop: humor pelos passos e pela hora; tocar nele abre o app para conversar. -->
    <Group name="snoop" x="85" y="128" width="280" height="280">
      <Launch target="com.eiclaude.snoop/com.eiclaude.snoop.MainActivity"/>
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <ListConfiguration id="soneca">
        <ListOption id="dia">
          <Condition>
            <Expressions>
              <Expression name="dormindo"><![CDATA[[HOUR_0_23] >= 8 && 14 > [HOUR_0_23]]]></Expression>
              <Expression name="feliz"><![CDATA[[STEP_GOAL] > 0 && [STEP_COUNT] >= [STEP_GOAL]]]></Expression>
              <Expression name="preguica"><![CDATA[[HOUR_0_23] >= 17 && 30 > [STEP_PERCENT]]]></Expression>
            </Expressions>
            <Compare expression="dormindo">
              <PartImage name="snoop_dormindo" x="0" y="0" width="280" height="280">
                <Image resource="snoop_dormindo"/>
              </PartImage>
            </Compare>
            <Compare expression="feliz">
              <PartImage name="snoop_feliz" x="0" y="0" width="280" height="280">
                <Image resource="snoop_feliz"/>
              </PartImage>
            </Compare>
            <Compare expression="preguica">
              <PartImage name="snoop_preguica" x="0" y="0" width="280" height="280">
                <Image resource="snoop_preguica"/>
              </PartImage>
            </Compare>
            <Default>
              <PartImage name="snoop_normal" x="0" y="0" width="280" height="280">
                <Image resource="snoop_normal"/>
              </PartImage>
            </Default>
          </Condition>
        </ListOption>
        <ListOption id="noite">
          <Condition>
            <Expressions>
              <Expression name="dormindo"><![CDATA[[HOUR_0_23] >= 23 || 6 > [HOUR_0_23]]]></Expression>
              <Expression name="feliz"><![CDATA[[STEP_GOAL] > 0 && [STEP_COUNT] >= [STEP_GOAL]]]></Expression>
              <Expression name="preguica"><![CDATA[[HOUR_0_23] >= 17 && 30 > [STEP_PERCENT]]]></Expression>
            </Expressions>
            <Compare expression="dormindo">
              <PartImage name="snoop_dormindo" x="0" y="0" width="280" height="280">
                <Image resource="snoop_dormindo"/>
              </PartImage>
            </Compare>
            <Compare expression="feliz">
              <PartImage name="snoop_feliz" x="0" y="0" width="280" height="280">
                <Image resource="snoop_feliz"/>
              </PartImage>
            </Compare>
            <Compare expression="preguica">
              <PartImage name="snoop_preguica" x="0" y="0" width="280" height="280">
                <Image resource="snoop_preguica"/>
              </PartImage>
            </Compare>
            <Default>
              <PartImage name="snoop_normal" x="0" y="0" width="280" height="280">
                <Image resource="snoop_normal"/>
              </PartImage>
            </Default>
          </Condition>
        </ListOption>
        <ListOption id="nunca">
          <Condition>
            <Expressions>
              <Expression name="dormindo"><![CDATA[1 == 0]]></Expression>
              <Expression name="feliz"><![CDATA[[STEP_GOAL] > 0 && [STEP_COUNT] >= [STEP_GOAL]]]></Expression>
              <Expression name="preguica"><![CDATA[[HOUR_0_23] >= 17 && 30 > [STEP_PERCENT]]]></Expression>
            </Expressions>
            <Compare expression="dormindo">
              <PartImage name="snoop_dormindo" x="0" y="0" width="280" height="280">
                <Image resource="snoop_dormindo"/>
              </PartImage>
            </Compare>
            <Compare expression="feliz">
              <PartImage name="snoop_feliz" x="0" y="0" width="280" height="280">
                <Image resource="snoop_feliz"/>
              </PartImage>
            </Compare>
            <Compare expression="preguica">
              <PartImage name="snoop_preguica" x="0" y="0" width="280" height="280">
                <Image resource="snoop_preguica"/>
              </PartImage>
            </Compare>
            <Default>
              <PartImage name="snoop_normal" x="0" y="0" width="280" height="280">
                <Image resource="snoop_normal"/>
              </PartImage>
            </Default>
