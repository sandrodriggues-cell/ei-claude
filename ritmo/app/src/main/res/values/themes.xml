<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema claro: a página segue o tema do celular (claro ou escuro). -->
    <style name="RitmoTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:navigationBarColor">@color/surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Alarme de evento: sempre escuro, como uma tela de ligação. -->
    <style name="RitmoAlarmTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
